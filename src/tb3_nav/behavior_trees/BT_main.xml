<root main_tree_to_execute="MainNavigator">

  <!-- Hauptbaum -->
  <BehaviorTree ID="MainNavigator">
    <!-- hier wählst du je nach Mission den passenden SubTree -->
    <Sequence>
      <IsMission1Active/>
      <SubTree ID="Mission1_TrackFollowing"/>
    </Sequence>
  </BehaviorTree>

  <!-- SubTree für Mission 1 -->
  <BehaviorTree ID="Mission1_TrackFollowing">
    <!-- LaneFollowUntilStopOrFinish ... -->
  </BehaviorTree>

  <!-- später weitere BehaviorTree-Blöcke für Mission2/3/4 -->
</root>
<root main_tree_to_execute="MainNavigator">

  <!-- ============================= -->
  <!--  MAIN TREE: Mission-Auswahl   -->
  <!-- ============================= -->
  <BehaviorTree ID="MainNavigator">
    <!--
      Fallback: probiere Mission 1, wenn nicht aktiv => Mission 2, ...
      Genau EINE Mission soll "IsMissionActive" == SUCCESS liefern.
    -->
    <Fallback name="SelectMission">

      <!-- Mission 1: Track following (Lane-Follow) -->
      <Sequence name="DoMission1">
        <IsMissionActive mission_id="1"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission1_TrackFollowing"/>
      </Sequence>

      <!-- Mission 2: Obstacle avoiding -->
      <Sequence name="DoMission2">
        <IsMissionActive mission_id="2"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission2_ObstacleAvoid"/>
      </Sequence>

      <!-- Mission 3: Closed area (Kasten, Kamera verboten) -->
      <Sequence name="DoMission3">
        <IsMissionActive mission_id="3"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission3_ClosedArea"/>
      </Sequence>

      <!-- Mission 4: Storage / Pallet handling -->
      <Sequence name="DoMission4">
        <IsMissionActive mission_id="4"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission4_PalletHandling"/>
      </Sequence>

      <!-- Mission 5: Secret mission (Platzhalter) -->
      <Sequence name="DoMission5">
        <IsMissionActive mission_id="5"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission5_SecretMission"/>
      </Sequence>

    </Fallback>
  </BehaviorTree>


  <!-- ======================================= -->
  <!--  Mission 1: Track Following (Lane-Follow) -->
  <!-- ======================================= -->
  <BehaviorTree ID="Mission1_TrackFollowing">
    <!--
      Grundidee:
      - Warte, bis Lanes erkannt sind
      - Solange kein STOP / Finish:
          - Lokalen Pfad aus Lane generieren
          - Pfad folgen
      - Bei STOP / Finish: weich abbremsen und Mission SUCCESS beenden
    -->
    <Sequence name="LaneFollowMain">

      <!-- 1) Warten, bis Lane sichtbar -->
      <RetryUntilSuccessful num_attempts="-1">
        <IsLaneVisible/>      <!-- CUSTOM Condition: liest z.B. /lane_centerline -->
      </RetryUntilSuccessful>

      <!-- 2) Hauptschleife Lane-Follow -->
      <!-- RateController kommt aus Nav2 und ruft das Kind z.B. mit 10 Hz auf -->
      <RateController hz="10.0">
        <Fallback name="FollowOrStop">

          <!-- Branch A: STOP / Finish erkannt -->
          <Sequence name="HandleStopOrFinish">
            <IsStopOrFinishDetected/>   <!-- CUSTOM Condition: /traffic_signs -->
            <SlowDownAndStop/>         <!-- CUSTOM Action: Geschwindigkeit runter, STOP -->
          </Sequence>

          <!-- Branch B: normal weiter der Spur folgen -->
          <Sequence name="LaneStep">
            <!-- Pfad aus Lane generieren (lokaler Pfad, z.B. 1.5 m Lookahead) -->
            <ComputeLanePath lookahead="1.5"/>  <!-- CUSTOM Action: ruft lane_path_server -->
            <!-- Pfad mit Nav2-Controller folgen -->
            <FollowPath server_name="FollowPath"
                        controller_id="LaneController"/>   <!-- Nav2 BT-Action-Node -->
          </Sequence>

        </Fallback>
      </RateController>

    </Sequence>
  </BehaviorTree>


  <!-- ===================================== -->
  <!--  Mission 2: Obstacle Avoiding        -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission2_ObstacleAvoid">
    <!--
      Sehr grob:
      - ggf. Startpose / Startposition sichern
      - Pfad durch Hindernisfeld planen
      - Pfad folgen
      - Vor Barriere anhalten
      Später können hier spezielle Verhalten rein (z.B. enges Ausweichen).
    -->
    <Sequence name="ObstacleAvoidMain">

      <!-- Optional: sicherstellen, dass Odom / Map ok sind -->
      <InitialPoseReceived/>     <!-- Nav2 Condition, optional -->

      <!-- Pfad bis kurz vor die Barriere planen (global oder lokal) -->
      <ComputePathToObstacleEnd/>   <!-- CUSTOM Action: könnte ComputePathToPose wrappen -->

      <!-- Pfad folgen unter Nutzung der local costmap -->
      <FollowPath path="{path}"
                  controller_id="ObstacleController" />

      <!-- Vor Barriere stehen bleiben -->
      <StopAtBarrier/>              <!-- CUSTOM Action: stutzt Geschwindigkeit auf 0, check Abstand -->

    </Sequence>
  </BehaviorTree>


  <!-- ===================================== -->
  <!--  Mission 3: Closed Area (Kasten)      -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission3_ClosedArea">
    <!--
      Idee:
      1) Eingang finden und hineinfahren (mit Kamera/oder Lidar-Logik, je nach Regel)
      2) Im Kasten Frontier-/Exit-Exploration (nur Lidar),
         bis Ausgang gefunden und verlassen
      3) Optional: Variante mit Hindernissen (Regelteil 3)
    -->
    <!-- 1) Eingang lokalisieren und hinein fahren -->
    <EnterClosedArea/>
    
    <!-- 2) Pfad zum aktuellen Exit-/Zwischenziel planen + glätten -->
    <Sequence name="ClosedAreaMain">
      <!-- Dein Node, der ein Ziel im Kasten/bei der Lücke setzt -->
      <ComputeExitGoal goal="{exit_goal}"/>  <!-- CUSTOM: setzt exit_goal aufs Blackboard -->

      <!-- Globalen Pfad berechnen -->
      <ComputePathToPose goal="{exit_goal}"
                         path="{exit_path}"
                         planner_id="GridBased"
                         error_code_id="{compute_path_error_code}"
                         error_msg="{compute_path_error_msg}"/>

      <!-- Pfad nur in Mission 3 glätten -->
      <SmoothPath unsmoothed_path="{exit_path}"
                  smoothed_path="{exit_path}"
                  smoother_id="closed_area_smoother"
                  error_code_id="{smoother_error_code}"
                  error_msg="{smoother_error_msg}"/>
    </Sequence>

    <FollowPath path="{exit_path}"
                controller_id="ObstacleController"
                server_name="FollowPath"/>

      <!-- 3) Draußen angekommen: ggf. vor definierter Linie stoppen -->
      <StopAfterExit/>             <!-- CUSTOM Action: optional -->

    </Sequence>
  </BehaviorTree>


  <!-- ===================================== -->
  <!--  Mission 4: Storage / Pallet Handling -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission4_PalletHandling">
    <!--
      Grobe Schritte nach Regelwerk:
      1) Lagerbereich / Zone 1 erkennen
      2) Palette detektieren und anfahren
      3) Elektromagnet aktivieren (Pickup)
      4) Transport von Zone 1 zu Zone 2 ohne andere Zonen zu kreuzen
      5) Palette zentriert in Zone 2 ablegen
      6) Lagerbereich verlassen
    -->
    <Sequence name="PalletHandlingMain">

      <!-- 1) Zone 1 finden -->
      <DetectZone zone_id="1"/>           <!-- CUSTOM Action: Schild/Markierung erkennen -->

      <!-- 2) Palette lokalisieren und andocken -->
      <ApproachPallet/>                   <!-- CUSTOM Action: Kamera + Lidar + Controller -->

      <!-- 3) Magnet an -->
      <ActivateElectromagnet/>           <!-- CUSTOM Action: GPIO / Topic -->

      <!-- 4) Transportpfad von Zone 1 zu Zone 2 planen (Route, Waypoints oder Graph) -->
      <ComputePalletTransportPath/>      <!-- CUSTOM Action: ComputePathThroughPoses / Router -->

      <!-- 5) Pfad folgen (mit größerem Footprint, damit Palette berücksichtigt wird) -->
      <FollowPath path="{path}"
                  controller_id="PalletController" />

      <!-- 6) Palette in Zone 2 zentriert ablegen -->
      <DropPalletInZone zone_id="2"/>    <!-- CUSTOM Action: Positionieren + Magnet aus -->

      <!-- 7) Lagerbereich verlassen (z.B. zur Ausgangszone fahren) -->
      <LeaveStorageArea/>                <!-- CUSTOM Action: kleines Nav-Ziel oder Lane-Follow raus -->

    </Sequence>
  </BehaviorTree>


  <!-- ===================================== -->
  <!--  Mission 5: Secret Mission (Stub)     -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission5_SecretMission">
    <!--
      Platzhalter – später abhängig von offizieller Aufgabenstellung füllen.
      Aktuell: einfach SUCCESS zurückgeben, damit BTNavigator nicht abstürzt,
      falls mission_id=5 gesetzt wäre.
    -->
    <Sequence name="SecretMissionStub">
      <LogInfo message="Secret mission not implemented yet"/>  <!-- Nav2 BT log node möglich -->
    </Sequence>
  </BehaviorTree>

</root>
