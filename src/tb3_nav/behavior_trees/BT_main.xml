<root main_tree_to_execute="MainNavigator">

  <!-- Hauptbaum -->
  <BehaviorTree ID="MainNavigator">
    <!-- hier wählst du je nach Mission den passenden SubTree -->
    <Sequence>
      <IsMission1Active/>
      <SubTree ID="Mission1_TrackFollowing"/>
    </Sequence>
  </BehaviorTree>

  <!-- SubTree für Mission 1 -->
  <BehaviorTree ID="Mission1_TrackFollowing">
    <!-- LaneFollowUntilStopOrFinish ... -->
  </BehaviorTree>

  <!-- später weitere BehaviorTree-Blöcke für Mission2/3/4 -->
</root>
<root main_tree_to_execute="MainNavigator">

  <!-- ============================= -->
  <!--  MAIN TREE: Mission-Auswahl   -->
  <!-- ============================= -->
  <BehaviorTree ID="MainNavigator">
    <!--
      Fallback: probiere Mission 1, wenn nicht aktiv => Mission 2, ...
      Genau EINE Mission soll "IsMissionActive" == SUCCESS liefern.
    -->
    <Fallback name="SelectMission">

      <!-- Mission 3: Closed area (Kasten, Kamera verboten) -->
      <Sequence name="DoMission3">
        <IsMissionActive mission_id="3"/>          <!-- CUSTOM Condition -->
        <SubTree ID="Mission3_ClosedArea"/>
      </Sequence>

    </Fallback>
  </BehaviorTree>
  
  <!-- ===================================== -->
  <!--  Mission 3: Closed Area (Kasten)      -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission3_ClosedArea">
    <!--
      Idee:
      1) Eingang finden und hineinfahren (mit Kamera/oder Lidar-Logik, je nach Regel)
      2) Im Kasten Frontier-/Exit-Exploration (nur Lidar),
         bis Ausgang gefunden und verlassen
      3) Optional: Variante mit Hindernissen (Regelteil 3)
    -->
    <!-- 1) Eingang lokalisieren und hinein fahren -->
    <EnterClosedArea/>
    
    <!-- 2) Pfad zum aktuellen Exit-/Zwischenziel planen + glätten -->
    <Sequence name="ClosedAreaMain">
      <!-- Dein Node, der ein Ziel im Kasten/bei der Lücke setzt -->
      <ComputeExitGoal goal="{exit_goal}"/>  <!-- CUSTOM: setzt exit_goal aufs Blackboard -->

      <!-- Globalen Pfad berechnen -->
      <ComputePathToPose goal="{exit_goal}"
                         path="{exit_path}"
                         planner_id="GridBased"
                         error_code_id="{compute_path_error_code}"
                         error_msg="{compute_path_error_msg}"/>

      <!-- Pfad nur in Mission 3 glätten -->
      <SmoothPath unsmoothed_path="{exit_path}"
                  smoothed_path="{exit_path}"
                  smoother_id="closed_area_smoother"
                  error_code_id="{smoother_error_code}"
                  error_msg="{smoother_error_msg}"/>
    </Sequence>

    <FollowPath path="{exit_path}"
                controller_id="ObstacleController"
                server_name="FollowPath"/>

      <!-- 3) Draußen angekommen: ggf. vor definierter Linie stoppen -->
      <StopAfterExit/>             <!-- CUSTOM Action: optional -->

    </Sequence>
  </BehaviorTree>


  <!-- ===================================== -->
  <!--  Mission 5: Secret Mission (Stub)     -->
  <!-- ===================================== -->
  <BehaviorTree ID="Mission5_SecretMission">
    <!--
      Platzhalter – später abhängig von offizieller Aufgabenstellung füllen.
      Aktuell: einfach SUCCESS zurückgeben, damit BTNavigator nicht abstürzt,
      falls mission_id=5 gesetzt wäre.
    -->
    <Sequence name="SecretMissionStub">
      <LogInfo message="Secret mission not implemented yet"/>  <!-- Nav2 BT log node möglich -->
    </Sequence>
  </BehaviorTree>

</root>
